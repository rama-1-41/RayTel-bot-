{
  "name": "Android Telegram Bot",
  "description": "Remote control your Android phone via Telegram",
  "keywords": ["telegram", "bot", "android", "remote"],
  "env": {
    "BOT_TOKEN": {
      "description": "Your Telegram Bot Token from @BotFather",
      "required": true
    },
    "ADMIN_CHAT_ID": {
      "description": "Your Telegram User ID for authorization",
      "required": true
    },
    "HEROKU_APP_NAME": {
      "description": "Your Heroku app name",
      "required": true
    }
  },
  "buildpacks": [
    {
      "url": "heroku/python"
    }
  ]
}
